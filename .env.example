# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-content-repo
GITHUB_BRANCH=draft
GITHUB_PUBLISH_BRANCH=main
GITHUB_CONTENT_PATH=content

# GitHub OAuth App — sign-in ("Login with GitHub"). Roles are derived from the
# user's permission on GITHUB_OWNER/GITHUB_REPO (admin->Admin, maintain->Moderator,
# write->Editor; below write = no access). Create one at
# https://github.com/settings/developers -> New OAuth App, with
# Authorization callback URL: <your-site-origin>/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-app-client-secret

# Session secret (generate a random string)
SESSION_SECRET=change-me-to-a-random-secret

# API Token (optional) — if set, all public API/embed endpoints require
# Authorization: Bearer <token> header or ?token=<token> query parameter.
# Leave unset for a fully public API.
# API_TOKEN=your-secret-api-token
