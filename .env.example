# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-content-repo
GITHUB_BRANCH=draft
GITHUB_PUBLISH_BRANCH=main
GITHUB_CONTENT_PATH=content

# Session secret (generate a random string)
SESSION_SECRET=change-me-to-a-random-secret

# API Token (optional) — if set, all public API/embed endpoints require
# Authorization: Bearer <token> header or ?token=<token> query parameter.
# Leave unset for a fully public API.
# API_TOKEN=your-secret-api-token
