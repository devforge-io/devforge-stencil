# GitHub Configuration
# GITHUB_TOKEN is OPTIONAL. If set, all git operations use it (a shared service
# account). If unset, operations use the signed-in user's own GitHub OAuth token
# (so commits are attributed to them). Note: anonymous public page serving has no
# signed-in user, so with no GITHUB_TOKEN it can only read a PUBLIC repo — a
# private repo still needs GITHUB_TOKEN set for public serving.
# GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-content-repo
GITHUB_BRANCH=draft
GITHUB_PUBLISH_BRANCH=main
GITHUB_CONTENT_PATH=content

# GitHub OAuth App — sign-in ("Login with GitHub"). Roles are derived from the
# user's permission on GITHUB_OWNER/GITHUB_REPO (admin->Admin, maintain->Moderator,
# write->Editor; below write = no access). Create one at
# https://github.com/settings/developers -> New OAuth App, with
# Authorization callback URL: <your-site-origin>/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-app-client-secret

# Session secret (generate a random string)
SESSION_SECRET=change-me-to-a-random-secret

# API Token (optional) — if set, all public API/embed endpoints require
# Authorization: Bearer <token> header or ?token=<token> query parameter.
# Leave unset for a fully public API.
# API_TOKEN=your-secret-api-token

# Contact form SMTP (optional) — overrides the SMTP config in settings.json.
# Recommended for the password so it stays out of the content repo. Set the
# recipient (and the rest of the SMTP config) under /content/settings.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=site@example.com
# Verbose SMTP logging for the contact form (logs the full SMTP conversation).
# CONTACT_DEBUG=1

# Feature requests tool (/tools/feature-requests). Accounts, projects, requests
# and votes live in Anvil DB. The app talks to Anvil as a service principal:
# either an API key minted for a service account (preferred, newer Anvil builds)
# or the admin user's credentials. End users sign up / sign in through Anvil's
# own auth endpoints; the app keeps its own signed session cookie (SESSION_SECRET).
# ANVIL_URL=https://anvil.example.com
# ANVIL_SERVICE_KEY=anvil_sk_...
# ANVIL_ADMIN_USER=admin
# ANVIL_ADMIN_PASSWORD=
# Only set ANVIL_DATABASE for a non-default database (on Anvil 0.1.0 naming it
# also switches the schema context).
# ANVIL_DATABASE=
# Anvil app the Devforge account belongs to (default devforge): account sign-up and
# emailed-code requests name it, and every sign-in enrols the person as a reader member.
# ANVIL_APP=devforge
# Devforge's own account roles live in Anvil (app_devforge.roles, assignments in
# app_devforge.accounts) and are managed at /account/people. The addresses listed here
# are admins whatever is stored, which is how the first admin gets in. Comma-separated.
# ACCOUNT_ADMINS=you@example.com
# Public origin used in the embed snippets shown to project owners (defaults to the request origin).
# PUBLIC_ORIGIN=https://devforge.io

# Hammer licence sales (/products/hammer/purchase, /account/licenses). Keys are
# issued by hallmark, the Devforge licence service (devforge-io/hallmark, at
# licensing.devforge.io:8443); payment is a yearly Stripe subscription, one key per
# seat and one seat per computer. Setup and operations: HAMMER-LICENSING.md.
# HALLMARK_URL=https://licensing.devforge.io:8443
# HALLMARK_ADMIN_TOKEN=          # admin_token from /etc/hallmark/hallmark.toml on the licensing host; never the signing_key
# HALLMARK_PUBLIC_KEY=           # GET /v1/public-key on the service; the same key Hammer embeds
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # signing secret of the webhook endpoint for <PUBLIC_ORIGIN>/api/stripe/webhook
# STRIPE_PRICE_HAMMER=price_...    # optional; otherwise the active price with lookup key hammer_yearly is used
# Where Stripe sends the buyer back to (Checkout success/cancel, Customer Portal return).
# Unset: the origin the request came in on, so a dev server on localhost round-trips to
# localhost. Set it on the production deployment only. PUBLIC_ORIGIN is not used for this.
# STRIPE_RETURN_ORIGIN=https://devforge.io
